{
  "indexers": [
    {
      "name": "production",
      "host": "http://prod-es:9200/*/_search",
      "user": "prod_user",
      "password": "prod_pass",
      "interval": 20.0
    },
    {
      "name": "staging",
      "host": "http://stage-es:9200/*/_search",
      "user": "stage_user",
      "password": "stage_pass",
      "interval": 30.0
    }
  ]
}

